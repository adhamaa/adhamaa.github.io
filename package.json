{
  "name": "my-portfolio",
  "version": "1.7.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "content": "node scripts/compile-content.mts",
    "dev": "pnpm run content && next dev",
    "build": "pnpm run content && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "pnpm run content && tsc --noEmit",
    "test:content": "node --test \"src/content/**/*.test.mts\"",
    "test:e2e": "pnpm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "clean": "rm -rf .next node_modules out",
    "dev:tina": "pnpm run content && tinacms dev -c \"next dev\""
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tinacms/mdx": "2.3.0",
    "@types/node": "20.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "lucide-react": "^1.31.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "postcss": "8.4.27",
    "react": "19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.3",
    "tinacms": "3.14.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.1.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tinacms/cli": "3.1.0"
  }
}
